# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Opcional: conexión directa (puerto 5432) solo para drizzle-kit push si DATABASE_URL usa pooler :6543
# DATABASE_URL_DIRECT=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# (Supabase también documenta DIRECT_URL en algunos templates; drizzle.config acepta ambos.)

# LLM (OpenAI SDK — cloud o compatible local / DGX Spark vLLM)
# Spark (recomendado): Funnel + Caddy /llm-api → vLLM :8000
# OPENAI_BASE_URL=https://spark-279e.tail0b36db.ts.net/llm-api/v1
# OPENAI_API_KEY=<mismo Bearer del Caddy handle /llm-api>
# OPENAI_MODEL=gemma4
# LAN/Tailscale directo (sin Caddy; solo red privada):
# OPENAI_BASE_URL=http://100.116.242.33:8000/v1
# OPENAI_API_KEY=local
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gemma4

# Resend (invitaciones por correo; opcional)
# https://resend.com — verifica un dominio o usa el remitente de prueba de Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="OpsFlow <onboarding@resend.dev>"

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Admin-only HTTP routes (/api/migrate, /api/seed)
# In production: required + send header `x-opsflow-admin-secret: <value>`
# In development: optional; if set, header must match
OPSFLOW_ADMIN_API_SECRET=

# Multi-tenant (producción SaaS)
# OPSFLOW_STRICT_TENANCY=true — no auto-asignar nuevos usuarios a la org demo; requieren invitación
# OPSFLOW_PLATFORM_ADMIN_EMAILS=admin@empresa.com — correos que pueden crear organizaciones nuevas
OPSFLOW_STRICT_TENANCY=
OPSFLOW_PLATFORM_ADMIN_EMAILS=
