{
  "base_branch": "main",
  "merge_method": "squash",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "max_rounds": 3,
  "concurrency": 1,
  "max_jobs_per_day": 5,
  "codex_timeout_seconds": 900,
  "classes": {
    "D": [
      "factory/*",
      ".claude/*",
      ".github/*",
      ".husky/*",
      ".githooks/*",
      "lefthook.yml",
      ".lefthook*",
      ".npmrc",
      "*.gitattributes",
      "vitest.config.*",
      "eslint.config.*",
      "tsconfig.json",
      "postcss.config.*",
      ".codex/*",
      ".cursor/*",
      ".yarnrc*",
      ".pnpmfile.cjs",
      "*AGENTS*.md",
      "*CLAUDE*.md"
    ],
    "C": [
      "src/server/auth/*",
      "src/server/db/*",
      "src/server/ai/*",
      "src/server/email/*",
      "src/server/lib/admin-api-route.ts",
      "src/app/api/*",
      "src/app/auth/*",
      "src/app/(app)/invite/*",
      "src/app/(app)/organization/*",
      "src/lib/supabase/*",
      "supabase/*",
      "drizzle.config.ts",
      "vercel.json",
      "vercel.ts",
      "next.config.*",
      "src/proxy.*",
      "proxy.*",
      "src/middleware.*",
      "middleware.*",
      "instrumentation*",
      "src/instrumentation*",
      "sentry.*.config.*",
      "npm-shrinkwrap.json",
      "src/lib/organization-settings.ts",
      "*permission*",
      "*roles*",
      "*membership*",
      "src/pages/api/*",
      "src/app/*/actions.ts",
      "src/app/*route.ts",
      "src/app/*route.tsx",
      "src/app/*route.js",
      "src/app/*route.jsx",
      "src/app/(app)/dashboard/layout.tsx",
      "src/app/(app)/layout.tsx",
      "src/server/actions/*",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock",
      "bun.lockb",
      "src/features/auth/*"
    ]
  },
  "tests": [
    "*.test.ts",
    "*.test.tsx"
  ],
  "acceptance_exempt": [
    "package.json",
    "package-lock.json",
    "*.md",
    "docs/*"
  ],
  "acceptance_cmd": [
    "npx",
    "vitest",
    "run"
  ],
  "reviewers": {
    "always": {
      "code": "codex",
      "security": "codex"
    },
    "ui": {
      "ui": "sonnet"
    }
  },
  "ui_paths": [
    "src/app/*.tsx",
    "src/components/*",
    "src/features/*.tsx",
    "src/app/globals.css"
  ],
  "gate_outputs": [
    "next-env.d.ts"
  ],
  "autonomous": [
    "src/lib/calculations/*",
    "src/lib/constants/*",
    "src/lib/utils.ts",
    "src/hooks/*",
    "src/components/*",
    "src/features/*/components/*",
    "*.test.ts",
    "*.test.tsx",
    "docs/*",
    "README.md",
    "CHANGELOG.md",
    "package.json",
    "package-lock.json",
    "public/*.png",
    "public/*.jpg",
    "public/*.jpeg",
    "public/*.gif",
    "public/*.webp",
    "public/*.avif",
    "public/*.ico",
    "public/*.woff",
    "public/*.woff2"
  ],
  "sensitive_content": [
    "[\"']use server[\"']",
    "from\\s+[\"'](@/server/(?!actions/)|@/lib/supabase|@/lib/organization-settings)",
    "from\\s+[\"'](drizzle-orm|postgres|@supabase/|openai|server-only)",
    "\\bprocess\\.env\\b",
    "\\bfetch\\s*\\(\\s*[\"'`]https?:",
    "\\bdangerouslySetInnerHTML\\b",
    "\\b(document\\.cookie|localStorage|sessionStorage)\\b"
  ]
}
