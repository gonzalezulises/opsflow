{
  "base_branch": "main",
  "merge_method": "squash",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "max_rounds": 3,
  "concurrency": 1,
  "max_jobs_per_day": 5,
  "codex_timeout_seconds": 900,
  "classes": {
    "D": [
      "factory/*",
      ".claude/*",
      ".github/*",
      ".husky/*",
      ".githooks/*",
      "lefthook.yml",
      ".lefthook*",
      ".npmrc",
      "*.gitattributes",
      "vitest.config.*",
      "eslint.config.*",
      "tsconfig.json",
      "postcss.config.*",
      ".codex/*",
      ".cursor/*",
      ".yarnrc*",
      ".pnpmfile.cjs",
      "*AGENTS*.md",
      "*CLAUDE*.md"
    ],
    "C": [
      "src/server/auth/*",
      "src/server/db/*",
      "src/server/ai/*",
      "src/server/email/*",
      "src/server/lib/admin-api-route.ts",
      "src/server/actions/organization.ts",
      "src/app/api/*",
      "src/app/auth/*",
      "src/app/(app)/invite/*",
      "src/app/(app)/organization/*",
      "src/lib/supabase/*",
      "supabase/*",
      "drizzle.config.ts",
      "vercel.json",
      "vercel.ts",
      "next.config.*",
      "src/proxy.*",
      "proxy.*",
      "src/middleware.*",
      "middleware.*",
      "instrumentation*",
      "src/instrumentation*",
      "sentry.*.config.*",
      "npm-shrinkwrap.json",
      "src/server/actions/org*",
      "src/lib/organization-settings.ts",
      "*permission*",
      "*roles*",
      "*membership*",
      "src/app/*route.ts",
      "src/app/*route.js",
      "src/pages/api/*",
      "src/app/*/actions.ts"
    ]
  },
  "tests": [
    "*.test.ts",
    "*.test.tsx"
  ],
  "acceptance_exempt": [
    "package.json",
    "package-lock.json",
    "*.md",
    "docs/*"
  ],
  "acceptance_cmd": [
    "npx",
    "vitest",
    "run"
  ],
  "reviewers": {
    "always": {
      "code": "codex",
      "security": "codex"
    },
    "ui": {
      "ui": "sonnet"
    }
  },
  "ui_paths": [
    "src/app/*.tsx",
    "src/components/*",
    "src/features/*.tsx",
    "src/app/globals.css"
  ]
}
